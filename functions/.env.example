# Deployed environment: use functions/lib/.env.PROJECT_ID or runtime parameters.
# Do not copy this into demo emulators. Their default is mock.
AI_MODE=live
REGION=europe-west1
TEXT_MODEL=gpt-5.4-mini-2026-03-17
IMAGE_MODEL=gpt-image-2.5-flare-2026-09-08
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_MS=45000
DAILY_AI_REQUEST_LIMIT=30
# Zero disables paid calls. Choose conservative reservations from current provider pricing.
DAILY_BUDGET_USD=0
SESSION_BUDGET_USD=0
TEXT_RESERVATION_USD=0
IMAGE_RESERVATION_USD=0
# Secret Manager binding: STORY_AI_KEY (never store a real key in this file)

# Comma-separated exact HTTPS origins for deployed callable functions.
ALLOWED_ORIGINS=
