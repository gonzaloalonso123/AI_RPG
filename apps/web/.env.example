# Local development defaults to emulators when no project is configured.
# Never put secrets in VITE_ variables. Copy to .env.local for a real project.
VITE_MODE=live
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_REGION=europe-west1
VITE_APPCHECK_SITE_KEY=

VITE_PRODUCT_NAME=Story Master
