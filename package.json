{
  "name": "story-master",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @story/web dev",
    "build": "pnpm --filter @story/web build && node scripts/build-functions.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:rules": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "emulators": "pnpm build && node scripts/emulators.mjs",
    "emulators:test": "pnpm build && node scripts/emulators.mjs --test",
    "seed": "node scripts/seed.mjs",
    "preflight": "node scripts/preflight.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "format": "prettier --write .",
    "prepare:functions": "npm ci --prefix functions/lib --no-audit --no-fund",
    "migrate": "node scripts/migrate.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "security": "node scripts/security-audit.mjs",
    "preflight:remote": "node scripts/preflight-remote.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "firebase-tools": "15.33.0",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "vite": "8.3.4",
    "prettier": "3.8.2"
  }
}
