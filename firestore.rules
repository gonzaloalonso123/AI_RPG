rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member(cid) {return request.auth != null && exists(/databases/$(database)/documents/campaigns/$(cid)) && request.auth.uid in get(/databases/$(database)/documents/campaigns/$(cid)).data.members;}
  match /campaigns/{cid} {
   allow read: if request.auth != null && request.auth.uid in resource.data.members;
   allow write: if false;
   match /events/{eventId} {allow read: if member(cid); allow write: if false;}
   match /summaries/{summaryId} {allow read: if member(cid); allow write: if false;}
   match /private/{uid} {allow read: if member(cid) && request.auth.uid == uid; allow write: if false;}
   match /{collection}/{document=**} {allow read, write: if false;}
  }
  match /{document=**} {allow read, write: if false;}
 }
}
